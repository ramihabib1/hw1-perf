{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git*)",
      "Bash(ls*)",
      "Bash(cat /usr/src/**)",
      "Bash(grep*)",
      "Bash(rg*)",
      "Bash(find /usr/src/**)"
    ],
    "ask": [
      "Bash(perf*)",
      "Bash(sudo perf*)",
      "Bash(bpftrace*)",
      "Bash(sudo bpftrace*)",
      "Bash(trace-cmd*)",
      "Bash(stress-ng*)",
      "Bash(sysbench*)",
      "Bash(turbostat*)",
      "Bash(cpupower*)",
      "Bash(/usr/lib/lmbench/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ]
  }
}
